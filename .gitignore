# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc

# Downloaded k6 binary (62 MB) - get it from https://k6.io
loadtest/k6

# Upstream clones' own git metadata (plugins are vendored here)
.git-upstream/

# Node dev tooling (e.g. plugins/theme/iiitdwd)
node_modules/

# Private keys of the LMS certificate authority and server certificate (tls/make-certs.sh).
tls/ca/
tls/server/

# Mailpit secrets (mailpit/configure.sh): web inbox password hash and SMTP relay credentials.
mailpit/secrets/

# Local assistant tooling (Claude Code settings and instructions, graphify knowledge graph)
/.claude/
/CLAUDE.md
/graphify-out/

# Database backups (contain user data and password hashes)
backup-*.sql.gz
*.sql.gz

# Load-test output (regenerated by each run; the findings are in the *REPORT.md files)
locust/results/
locust/*.xlsx
loadtest/results/
loadtest/results_storage_before.txt

# Generated test reports (the Markdown versions in docs/ are kept)
docs/moodle-curl-test-report.csv
docs/moodle-curl-test-report.pdf
docs/moodle-load-and-storage-results.xlsx

# Test and tool caches, logs
.phpunit.result.cache
*.log

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
