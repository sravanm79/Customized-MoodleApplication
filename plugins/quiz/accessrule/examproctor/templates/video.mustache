{{!
    @template quizaccess_examproctor/video

    Player for an attempt's recorded segments: plays them in order; the list jumps to one.

    Example context (json):
    {"firsturl": "https://example.com/1.webm", "segments": [{"index": 0, "label": "10:02", "url": "https://example.com/1.webm", "mimetype": "video/webm"}]}
}}
<div class="examproctor-video row g-3" data-region="examproctor-video">
    <div class="col-lg-8">
        <video class="examproctor-video-player w-100 rounded" controls muted playsinline preload="metadata"
               data-region="player" src="{{firsturl}}"></video>
    </div>
    <div class="col-lg-4">
        <ol class="list-group list-group-numbered examproctor-video-list">
            {{#segments}}
            <li class="list-group-item list-group-item-action{{^index}} active{{/index}}" role="button" tabindex="0"
                data-action="play-segment" data-index="{{index}}" data-url="{{url}}">{{label}}</li>
            {{/segments}}
        </ol>
    </div>
</div>
