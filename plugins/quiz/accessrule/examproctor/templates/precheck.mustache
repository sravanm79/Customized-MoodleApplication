{{!
    @template quizaccess_examproctor/precheck

    Student device pre-check. The browser checks are filled in by quizaccess_examproctor/precheck.

    Example context (json):
    {
        "quizname": "Python test",
        "quizurl": "https://moodle.example.edu/mod/quiz/view.php?id=10",
        "requiresseb": true,
        "camerarequired": true,
        "servercheck": [{"id": "https", "status": "ok", "label": "OK", "message": "The site uses HTTPS."}]
    }
}}
<div class="examproctor-precheck" data-region="examproctor-precheck">
    <h2 class="h3 mb-1">{{#str}} precheck_title, quizaccess_examproctor {{/str}}</h2>
    <p class="text-muted mb-3">{{quizname}}</p>

    <div class="examproctor-precheck-summary alert alert-secondary" data-region="summary" role="status" aria-live="polite">
        {{#str}} precheck_running, quizaccess_examproctor {{/str}}
    </div>

    <p>{{#str}} precheck_intro, quizaccess_examproctor {{/str}}</p>
    {{#requiresseb}}<p class="small">{{#str}} precheck_intro_seb, quizaccess_examproctor {{/str}}</p>{{/requiresseb}}

    <div class="row">
        <div class="col-lg-6 mb-3">
            <section class="examproctor-precheck-card">
                <h3 class="h5">{{#str}} precheck_camera, quizaccess_examproctor {{/str}}
                    {{^camerarequired}}<span class="badge bg-secondary ms-1">{{#str}} optional {{/str}}</span>{{/camerarequired}}</h3>
                <div class="examproctor-precheck-video">
                    <video data-region="video" autoplay muted playsinline aria-label="{{#str}} precheck_camera, quizaccess_examproctor {{/str}}"></video>
                    <span class="examproctor-precheck-video-empty" data-region="video-empty">{{#str}} precheck_cameraoff, quizaccess_examproctor {{/str}}</span>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-primary" data-action="camera">{{#str}} precheck_camstart, quizaccess_examproctor {{/str}}</button>
                    <button type="button" class="btn btn-outline-secondary" data-action="mic">{{#str}} precheck_mictest, quizaccess_examproctor {{/str}}</button>
                </div>
                <div class="examproctor-precheck-meter mt-2" aria-hidden="true"><span data-region="meter"></span></div>
                <p class="small text-muted mt-2 mb-0" data-region="device"></p>
            </section>
        </div>
        <div class="col-lg-6 mb-3">
            <section class="examproctor-precheck-card">
                <h3 class="h5">{{#str}} precheck_results, quizaccess_examproctor {{/str}}</h3>
                <ul class="examproctor-precheck-list" data-region="client-checks"></ul>
                <h3 class="h6 mt-3">{{#str}} precheck_server, quizaccess_examproctor {{/str}}</h3>
                <ul class="examproctor-precheck-list">
                    {{#servercheck}}
                    <li class="examproctor-check-{{status}}"><span class="examproctor-check-badge">{{label}}</span><span>{{message}}</span></li>
                    {{/servercheck}}
                </ul>
            </section>
        </div>
    </div>

    <details class="examproctor-precheck-card mb-3">
        <summary>{{#str}} precheck_report, quizaccess_examproctor {{/str}}</summary>
        <p class="small text-muted mt-2">{{#str}} precheck_report_help, quizaccess_examproctor {{/str}}</p>
        <textarea class="form-control font-monospace small" rows="10" readonly data-region="report"></textarea>
        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-action="copy">{{#str}} precheck_copy, quizaccess_examproctor {{/str}}</button>
    </details>

    <a class="btn btn-secondary" href="{{quizurl}}">{{#str}} precheck_back, quizaccess_examproctor {{/str}}</a>
</div>
