{{!
    @template quizaccess_examproctor/monitor

    Live exam monitor page: heading, refresh controls and the auto-refreshed content.

    Example context (json):
    {"quizname": "Midterm", "updated": "10:15:02", "tiles": [], "rows": [], "feed": [], "reporturl": "#", "resultsurl": "#"}
}}
<div class="examproctor-monitor">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h2 class="h3 mb-0 me-auto">{{#str}} monitor_title, quizaccess_examproctor, {{quizname}} {{/str}}</h2>
        <span class="small text-muted" aria-live="polite">
            <span class="examproctor-live-dot" data-region="live-dot"></span>
            {{#str}} mon_updated, quizaccess_examproctor {{/str}} <span data-region="updated">{{updated}}</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="toggle-refresh"
                data-pause="{{#str}} mon_pause, quizaccess_examproctor {{/str}}"
                data-resume="{{#str}} mon_resume, quizaccess_examproctor {{/str}}">{{#str}} mon_pause, quizaccess_examproctor {{/str}}</button>
        <a class="btn btn-sm btn-outline-secondary" href="{{reporturl}}">{{#str}} viewreport, quizaccess_examproctor {{/str}}</a>
        <a class="btn btn-sm btn-outline-secondary" href="{{resultsurl}}">{{#str}} mon_results, quizaccess_examproctor {{/str}}</a>
    </div>
    <div data-region="monitor-content">
        {{> quizaccess_examproctor/monitor_content }}
    </div>
</div>
