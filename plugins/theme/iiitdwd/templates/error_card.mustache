{{!
    @template theme_iiitdwd/error_card

    Error page content (theme_iiitdwd\output\core_renderer::fatal_error()): what happened in plain words, Moodle's
    message, and ways on (back, Dashboard, find a course, log in) instead of a link to Moodle Docs.

    Context variables required for this template:
    * title, hint - by kind of error (bad link, no access, other)
    * message - Moodle's error message (escaped here)
    * errorcode - shown small, for support requests
    * backurl, dashboardurl, searchurl
    * loginurl - only when not logged in

    Example context (json):
    {
        "title": "This link is incomplete or out of date",
        "hint": "The page you tried to open needs information the link did not include.",
        "message": "A required parameter (id) was missing",
        "errorcode": "missingparam",
        "backurl": "#",
        "dashboardurl": "#",
        "searchurl": "#",
        "loginurl": null
    }
}}
<section class="iiitdwd-error-card" data-rel="fatalerror" role="alert" aria-labelledby="iiitdwd-error-title">
    <div class="iiitdwd-error-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <circle cx="12" cy="12" r="10"/><path d="M12 7v6"/><path d="M12 16.5v.5"/>
        </svg>
    </div>
    <h2 id="iiitdwd-error-title" class="iiitdwd-error-title">{{title}}</h2>
    <p class="iiitdwd-error-hint">{{hint}}</p>
    <p class="iiitdwd-error-message errormessage">{{message}}</p>
    <div class="iiitdwd-error-actions">
        <a class="btn btn-primary" href="{{backurl}}">{{#str}}errorback, theme_iiitdwd{{/str}}</a>
        {{#loginurl}}<a class="btn btn-outline-secondary" href="{{loginurl}}">{{#str}}login{{/str}}</a>{{/loginurl}}
        {{^loginurl}}<a class="btn btn-outline-secondary" href="{{dashboardurl}}">{{#str}}myhome{{/str}}</a>{{/loginurl}}
        <a class="btn btn-outline-secondary" href="{{searchurl}}">{{#str}}errorfindcourse, theme_iiitdwd{{/str}}</a>
    </div>
    {{#errorcode}}<p class="iiitdwd-error-code">{{#str}}errorcode, theme_iiitdwd, {{.}}{{/str}}</p>{{/errorcode}}
</section>
