{{!
    @template theme_iiitdwd/course_nav_item

    One item of theme_iiitdwd/course_nav: an icon and link, and for items with sub-pages (Participants, Reports,
    Course reuse, ...) a button that expands them. The current page gets the pill (.active).

    Context variables required for this template:
    * text, url, icon (HTML), isactive, hasactivechild
    * haschildren, isopen, collapseid
    * children - text, url, isactive

    Example context (json):
    {
        "text": "Participants", "url": "#", "icon": "", "isactive": false, "hasactivechild": true,
        "haschildren": true, "isopen": true, "collapseid": "p1",
        "children": [{"text": "Enrolment methods", "url": "#", "isactive": true}]
    }
}}
<li class="iiitdwd-coursenav-item">
    <div class="iiitdwd-coursenav-row">
        <a href="{{url}}" class="iiitdwd-coursenav-link{{#isactive}} active{{/isactive}}{{#hasactivechild}} has-active-child{{/hasactivechild}}"
                {{#isactive}}aria-current="page"{{/isactive}}>
            <span class="iiitdwd-coursenav-icon">{{{icon}}}</span>
            <span class="iiitdwd-coursenav-text">{{text}}</span>
        </a>
        {{#haschildren}}
            <button type="button" class="iiitdwd-coursenav-expand{{^isopen}} collapsed{{/isopen}}" data-bs-toggle="collapse"
                    data-bs-target="#{{collapseid}}" aria-controls="{{collapseid}}"
                    aria-expanded="{{#isopen}}true{{/isopen}}{{^isopen}}false{{/isopen}}">
                <span class="visually-hidden">{{#str}}coursenavexpand, theme_iiitdwd, {{text}}{{/str}}</span>
                {{> theme_iiitdwd/course_nav_chevron }}
            </button>
        {{/haschildren}}
    </div>
    {{#haschildren}}
        <ul id="{{collapseid}}" class="iiitdwd-coursenav-children collapse{{#isopen}} show{{/isopen}}">
            {{#children}}
                <li>
                    <a href="{{url}}" class="iiitdwd-coursenav-sublink{{#isactive}} active{{/isactive}}"
                            {{#isactive}}aria-current="page"{{/isactive}}>{{text}}</a>
                </li>
            {{/children}}
        </ul>
    {{/haschildren}}
</li>
