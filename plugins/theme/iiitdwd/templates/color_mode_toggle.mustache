{{!
    @template theme_iiitdwd/color_mode_toggle

    Day/Night switch in the navbar, beside the notifications. A toggle button: "Dark mode", pressed in Night mode.
    The icon shows the mode a click switches to (moon in Day mode, sun in Night mode). Behaviour:
    amd/src/theme_toggle.js, which flips <html data-theme> and saves the choice.

    Context variables required for this template:
    * isdark - whether the page is in Night mode

    Example context (json):
    {
        "isdark": true
    }
}}
<div class="iiitdwd-color-mode d-flex align-items-center">
    <button type="button" class="btn iiitdwd-color-mode-toggle" data-action="iiitdwd-toggle-color-mode"
            aria-pressed="{{#isdark}}true{{/isdark}}{{^isdark}}false{{/isdark}}"
            title="{{#isdark}}{{#str}}switchtoday, theme_iiitdwd{{/str}}{{/isdark}}{{^isdark}}{{#str}}switchtonight, theme_iiitdwd{{/str}}{{/isdark}}"
            data-title-day="{{#str}}switchtoday, theme_iiitdwd{{/str}}"
            data-title-night="{{#str}}switchtonight, theme_iiitdwd{{/str}}">
        <svg class="iiitdwd-color-mode-icon iiitdwd-color-mode-sun" viewBox="0 0 24 24" width="18" height="18"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="iiitdwd-color-mode-icon iiitdwd-color-mode-moon" viewBox="0 0 24 24" width="18" height="18"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true" focusable="false">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <span class="visually-hidden">{{#str}}darkmode, theme_iiitdwd{{/str}}</span>
    </button>
</div>
