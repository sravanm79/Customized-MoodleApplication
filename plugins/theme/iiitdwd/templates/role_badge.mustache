{{!
    @template theme_iiitdwd/role_badge

    The logged-in user's role as a pill (theme_iiitdwd\local\user_role). Included by app_sidebar and the
    core/full_header override; the variant class sets the size.

    Context variables required for this template:
    * key - teacher, student, manager, admin or other (colour)
    * label - role name
    * arialabel - "Your role: ..."
    * variant - optional: sidebar or heading

    Example context (json):
    {
        "key": "teacher",
        "label": "Teacher",
        "arialabel": "Your role: Teacher",
        "variant": "heading"
    }
}}
<span class="iiitdwd-role-badge iiitdwd-role-{{key}}{{#variant}} iiitdwd-role-badge-{{.}}{{/variant}}" title="{{arialabel}}">
    <span class="visually-hidden">{{arialabel}}</span>
    <span aria-hidden="true">{{label}}</span>
</span>
