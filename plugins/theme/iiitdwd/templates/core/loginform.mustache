{{!
    @template core/loginform

    Login form.

    Overridden by theme_iiitdwd (from Moodle 5.0.1): the institution logo above the form, pill-shaped inputs,
    a full-width "Log in" button, "Forgotten your username or password?" and the support contact at the bottom.
    Field names, ids, the form action and the JS are unchanged, so login, the password toggle, autofocus and
    identity providers work as in core. Re-copy the form and JS from core when upgrading Moodle.

    Extra context (theme_iiitdwd\output\core_renderer::render_from_template()):
    * institutionname - the logo's alt text, and the wordmark when no logo is set
    * institutionlogourl - optional: the Institution logo theme setting
    * supportemail - optional: the Login support email theme setting

    Example context (json):
    {
        "sitename": "IIIT Dharwad",
        "institutionname": "INDIAN INSTITUTE OF INFORMATION TECHNOLOGY",
        "institutionlogourl": "",
        "copyrightyear": "2026",
        "supportemail": "support.dsai@iiitdwd.ac.in",
        "showloginform": true,
        "loginurl": "#",
        "logintoken": "token",
        "forgotpasswordurl": "#",
        "canloginasguest": false,
        "autofocusform": true,
        "togglepassword": true,
        "smallscreensonly": true
    }
}}
<div class="loginform iiitdwd-login">
    {{! Matches IIIT Dharwad's learning portal: logo on a navy card over the campus photo. }}
    <div class="iiitdwd-login-brand">
        {{#institutionlogourl}}
            <img src="{{institutionlogourl}}" class="iiitdwd-login-logo" alt="{{institutionname}}">
        {{/institutionlogourl}}
        {{^institutionlogourl}}
            <span class="iiitdwd-login-wordmark">{{institutionname}}</span>
        {{/institutionlogourl}}
    </div>
    <h1 class="visually-hidden">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>

    {{#maintenance}}
        <div class="iiitdwd-login-notice is-error login-maintenance">{{{maintenance}}}</div>
    {{/maintenance}}
    {{#error}}
        <a href="#" id="loginerrormessage" class="visually-hidden">{{error}}</a>
        <div class="iiitdwd-login-notice is-error" role="alert">{{#pix}}i/warning, core{{/pix}}{{error}}</div>
    {{/error}}
    {{#info}}
        <a href="#" id="logininfomessage" class="visually-hidden">{{info}}</a>
        <div class="iiitdwd-login-notice" role="alert">{{#pix}}i/warning, core{{/pix}}{{info}}</div>
    {{/info}}
    {{#cansignup}}
        <a href="{{signupurl}}" class="visually-hidden">{{#str}} tocreatenewaccount {{/str}}</a>
    {{/cansignup}}
    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <div class="login-form-username">
                <label for="username" class="iiitdwd-login-label">
                    {{^canloginbyemail}}{{#str}} username {{/str}}{{/canloginbyemail}}
                    {{#canloginbyemail}}{{#str}} usernameemail {{/str}}{{/canloginbyemail}}
                </label>
                <input type="text" name="username" id="username" class="form-control" value="{{username}}" autocomplete="username">
            </div>
            <div class="login-form-password">
                <label for="password" class="iiitdwd-login-label">{{#str}} password {{/str}}</label>
                <input type="password" name="password" id="password" value="" class="form-control" autocomplete="current-password">
            </div>
            <div class="iiitdwd-login-links">
                <button type="button" class="btn btn-link iiitdwd-login-showpassword" data-action="iiitdwd-show-password"
                        aria-controls="password" aria-pressed="false"
                        data-show="{{#str}}showpassword, theme_iiitdwd{{/str}}" data-hide="{{#str}}hidepassword, theme_iiitdwd{{/str}}">{{#str}}showpassword, theme_iiitdwd{{/str}}</button>
                <a href="{{forgotpasswordurl}}">{{#str}}forgotpassword, theme_iiitdwd{{/str}}</a>
            </div>
            {{#recaptcha}}
                <div class="login-form-recaptcha mb-3">
                    {{{recaptcha}}}
                </div>
            {{/recaptcha}}
            <div class="login-form-submit">
                <button class="btn btn-primary w-100" type="submit" id="loginbtn">{{#str}}signin, theme_iiitdwd{{/str}}</button>
            </div>
        </form>
    {{/showloginform}}
    {{#hasidentityproviders}}
        <div class="login-divider"></div>
        <div class="login-identityproviders">
            <h2 class="login-heading">{{#str}} potentialidps, auth {{/str}}</h2>
            {{#identityproviders}}
                <a class="btn login-identityprovider-btn w-100" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="24" height="24"/>
                    {{/iconurl}}
                    {{name}}
                </a>
            {{/identityproviders}}
        </div>
    {{/hasidentityproviders}}
    {{#hasinstructions}}
        <div class="login-divider"></div>
        <div class="login-instructions {{#cansignup}}mb-3{{/cansignup}}">
            <h2 class="login-heading">{{#str}}firsttime{{/str}}</h2>
            {{{instructions}}}
        </div>
    {{/hasinstructions}}
    {{#cansignup}}
        <div class="login-signup">
            <a class="btn btn-secondary w-100" href="{{signupurl}}">{{#str}}startsignup{{/str}}</a>
        </div>
    {{/cansignup}}
    {{#canloginasguest}}
        <div class="login-divider"></div>
        <form action="{{loginurl}}" method="post" id="guestlogin" class="iiitdwd-login-guest">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <input type="hidden" name="username" value="guest" />
            <input type="hidden" name="password" value="guest" />
            <span>{{#str}}someallowguest{{/str}}</span>
            <button class="btn btn-outline-secondary" type="submit" id="loginguestbtn">{{#str}}loginguest{{/str}}</button>
        </form>
    {{/canloginasguest}}
    <div class="iiitdwd-login-meta">
        {{#languagemenu}}
            <div class="login-languagemenu">
                {{>core/action_menu}}
            </div>
        {{/languagemenu}}
        <button type="button" class="btn btn-link iiitdwd-login-cookies" {{!
        }} data-modal="alert"{{!
        }} data-modal-title-str='["cookiesenabled", "core"]' {{!
        }} data-modal-content-str='["cookiesenabled_help_html", "core"]'{{!
        }}>{{#str}}cookiesnotice{{/str}}</button>
    </div>
</div>
<footer class="iiitdwd-login-copyright">
    <p>{{#str}}logincopyright, theme_iiitdwd, {{copyrightyear}}{{/str}}</p>
    {{#supportemail}}
        <p>{{#str}}loginsupport, theme_iiitdwd{{/str}} <a href="mailto:{{supportemail}}">{{supportemail}}</a></p>
    {{/supportemail}}
</footer>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    if (userNameField.value.length == 0) {
                        userNameField.focus();
                    } else {
                        document.getElementById('password').focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    {{#error}}
        document.getElementById('loginerrormessage').focus();
    {{/error}}
    {{! "Show password" link under the field (replaces core's eye button, which only appears on small screens). }}
    (function() {
        var button = document.querySelector('[data-action="iiitdwd-show-password"]');
        var field = document.getElementById('password');
        if (!button || !field) {
            return;
        }
        button.addEventListener('click', function() {
            var show = field.type === 'password';
            field.type = show ? 'text' : 'password';
            button.textContent = show ? button.dataset.hide : button.dataset.show;
            button.setAttribute('aria-pressed', show ? 'true' : 'false');
            field.focus();
        });
    })();
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
{{/js}}
