{{!
    @template local_studentportal/announcement

    One announcement in full.

    Example context (json):
    {"subject": "Exam schedule", "author": "Admin", "audience": "To all students", "date": "5 Oct 2026", "message": "<p>Hello</p>", "backurl": "#"}
}}
<div class="local-studentportal-page">
    <article class="iiitdwd-tdash-card local-studentportal-announcement">
        <h2 class="h4">{{subject}}</h2>
        <p class="local-studentportal-ann-meta">{{author}} · {{audience}} · {{date}}</p>
        <div class="local-studentportal-ann-body">{{{message}}}</div>
    </article>
    <a class="btn btn-secondary mt-3" href="{{backurl}}">{{#str}}allannouncements, local_studentportal{{/str}}</a>
</div>
