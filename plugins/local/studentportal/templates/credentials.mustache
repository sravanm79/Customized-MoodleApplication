{{!
    @template local_studentportal/credentials

    Freshly issued credentials, to download, print or email. Shown only for a short time.

    Example context (json):
    {
        "rows": [{"fullname": "Asha Rao", "idnumber": "23BDS001", "email": "asha@example.com", "username": "23bds001",
                  "password": "Xk7#pQ2mzA", "haspassword": true, "coursestext": "Python Lesson", "status": "New account"}],
        "count": 1, "created": 1, "withpassword": 1, "loginurl": "https://lms/login/index.php", "certurl": "http://lms:9999/lms-ca.crt",
        "downloadurl": "#", "actionurl": "#", "printurl": "#", "sesskey": "x", "expires": "10:45"
    }
}}
<div class="local-studentportal-page">
    <div class="alert alert-success">{{#str}}credentialsready, local_studentportal, {{count}}{{/str}}</div>
    <div class="alert alert-warning">{{#str}}credentialsonce, local_studentportal, {{expires}}{{/str}}</div>

    <div class="iiitdwd-tdash-card mb-3">
        <h3 class="iiitdwd-tdash-card-title">{{#str}}sharecredentials, local_studentportal{{/str}}</h3>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="{{downloadurl}}">{{#str}}downloadcsv, local_studentportal{{/str}}</a>
            <a class="btn btn-secondary" href="{{printurl}}" target="_blank" rel="noopener">{{#str}}printslips, local_studentportal{{/str}}</a>
            <form method="post" action="{{actionurl}}" class="d-inline">
                <input type="hidden" name="action" value="email"><input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-secondary">{{#str}}emailstudents, local_studentportal{{/str}}</button>
            </form>
            <button type="button" class="btn btn-secondary" data-action="local-studentportal-copy">{{#str}}copyall, local_studentportal{{/str}}</button>
        </div>
        <p class="small mt-2 mb-0">{{#str}}sharehelp, local_studentportal, {"loginurl": {{#quote}}{{loginurl}}{{/quote}}, "certurl": {{#quote}}{{certurl}}{{/quote}} }{{/str}}</p>
    </div>

    <div class="iiitdwd-tdash-card mb-3 table-responsive">
        <table class="table local-studentportal-table" data-region="local-studentportal-credentials">
            <thead><tr>
                <th>{{#str}}name{{/str}}</th><th>{{#str}}rollnumber, local_studentportal{{/str}}</th><th>{{#str}}email{{/str}}</th>
                <th>{{#str}}username{{/str}}</th><th>{{#str}}password{{/str}}</th><th>{{#str}}courses, local_studentportal{{/str}}</th>
                <th>{{#str}}result, local_studentportal{{/str}}</th>
            </tr></thead>
            <tbody>
            {{#rows}}
                <tr>
                    <td>{{fullname}}</td><td>{{idnumber}}</td><td>{{email}}</td><td><code>{{username}}</code></td>
                    <td>{{#haspassword}}<code class="local-studentportal-password">{{password}}</code>{{/haspassword}}
                        {{^haspassword}}<span class="small">{{#str}}passwordunchanged, local_studentportal{{/str}}</span>{{/haspassword}}</td>
                    <td class="small">{{coursestext}}</td><td><span class="local-studentportal-status">{{status}}</span></td>
                </tr>
            {{/rows}}
            </tbody>
        </table>
    </div>

    <form method="post" action="{{actionurl}}">
        <input type="hidden" name="action" value="done"><input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" class="btn btn-outline-secondary">{{#str}}donecredentials, local_studentportal{{/str}}</button>
    </form>
</div>
{{#js}}
    document.querySelector('[data-action="local-studentportal-copy"]').addEventListener('click', function(e) {
        var lines = ['Name\tUsername\tPassword\tLogin'];
        document.querySelectorAll('[data-region="local-studentportal-credentials"] tbody tr').forEach(function(tr) {
            var c = tr.querySelectorAll('td');
            lines.push(c[0].innerText.trim() + '\t' + c[3].innerText.trim() + '\t' + c[4].innerText.trim() + '\t{{loginurl}}');
        });
        var text = lines.join('\n');
        var done = function() { e.target.innerText = '✓ ' + e.target.innerText.replace(/^✓ /, ''); };
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(done);
        } else {
            var ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); ta.remove(); done();
        }
    });
{{/js}}
