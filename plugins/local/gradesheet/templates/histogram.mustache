{{!
    @template local_gradesheet/histogram

    Distribution of normalised scores in 10 % buckets, as bars, with a table for screen readers. A bucket with
    isown is the viewing student's.

    Example context (json):
    {
        "histogram": [
            {"label": "0–10%", "count": 0, "height": 0, "title": "0–10%: 0 students"},
            {"label": "80–90%", "count": 4, "height": 100, "isown": true, "title": "80–90%: 4 students"}
        ]
    }
}}
<figure class="local-gradesheet-histogram">
    <div class="local-gradesheet-bars" aria-hidden="true">
        {{#histogram}}
            <div class="local-gradesheet-bar{{#isown}} is-own{{/isown}}" title="{{title}}">
                <span class="local-gradesheet-bar-count">{{#count}}{{.}}{{/count}}</span>
                <span class="local-gradesheet-bar-fill" style="height: {{height}}%"></span>
                <span class="local-gradesheet-bar-label">{{label}}</span>
            </div>
        {{/histogram}}
    </div>
    <table class="visually-hidden">
        <caption>{{#str}}distribution, local_gradesheet{{/str}}</caption>
        <tr><th scope="col">{{#str}}range, local_gradesheet{{/str}}</th><th scope="col">{{#str}}students, local_gradesheet{{/str}}</th></tr>
        {{#histogram}}<tr><td>{{label}}{{#isown}} ({{#str}}yourrange, local_gradesheet{{/str}}){{/isown}}</td><td>{{count}}</td></tr>{{/histogram}}
    </table>
</figure>
