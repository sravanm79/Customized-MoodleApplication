{{!
    @template local_gradesheet/teacher_page

    Grade sheets page for teachers: upload button and every sheet (local_gradesheet/sheet_teacher).

    Example context (json):
    {
        "uploadurl": "#",
        "hassheets": false,
        "sheets": [],
        "studentcount": 42
    }
}}
<div class="local-gradesheet">
    <div class="local-gradesheet-head">
        <div>
            <h2>{{#str}}gradesheets, local_gradesheet{{/str}}</h2>
            <p class="text-muted">{{#str}}teacherintro, local_gradesheet, {{studentcount}}{{/str}}</p>
        </div>
        <a class="btn btn-primary" href="{{uploadurl}}">{{#str}}uploadsheet, local_gradesheet{{/str}}</a>
    </div>
    {{#sheets}}
        {{> local_gradesheet/sheet_teacher }}
    {{/sheets}}
    {{^hassheets}}
        <div class="local-gradesheet-empty card">
            <p>{{#str}}nosheets, local_gradesheet{{/str}}</p>
        </div>
    {{/hassheets}}
</div>
