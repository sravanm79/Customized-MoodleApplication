# Copy to .env and fill in. docker compose reads .env automatically. .env is git-ignored: never commit real values.
MARIADB_ROOT_PASSWORD=change_me
MOODLE_DB_PASSWORD=change_me
MOODLE_ADMIN_PASSWORD=change_me
# Generate with: openssl rand -hex 32  (also set it in Moodle: mod_jupyter | hubtoken)
MOODLE_SERVICE_TOKEN=change_me

# Moodle web service token for curl / API tests (Site administration > Server > Web services > Manage tokens).
MOODLE_WS_TOKEN=

# Mail (docs/email.md). Web inbox https://<moodle>/mail/ (user admin); generated by mailpit/configure.sh if empty.
MAILPIT_UI_PASSWORD=
# Optional real delivery through an SMTP account; leave SMTP_RELAY_HOST empty to keep all mail in Mailpit.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_FROM=
# Recipients (regular expression) that get real mail; default only @iiitdwd.ac.in addresses.
SMTP_RELAY_ONLY_TO=
